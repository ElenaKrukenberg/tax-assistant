# FastAPI
DEBUG=true
API_PORT=8000

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=tax_kb_2025

# Embeddings (OpenRouter, OpenAI-compatible /embeddings)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Logging
LOG_LEVEL=INFO

# LLM Model — same default as core/config.py and render.yaml. Models outside the price
# table in core/pricing.py report cost_usd = null rather than a wrong number.
LLM_MODEL=anthropic/claude-haiku-4.5

# The Reviewer's model: deliberately a different, stronger one than LLM_MODEL — and
# ideally a different vendor — so the audit's independence is more than a prompt.
# Empty falls back to LLM_MODEL. Verified live with the seeded defects (3/3).
REVIEWER_MODEL=openai/gpt-5.4

# Deployed frontend origins, comma-separated, matched exactly (no trailing slash).
# Empty locally: localhost:3000 and 127.0.0.1:3000 are always allowed.
CORS_EXTRA_ORIGINS=

# Rate limits on /ask, the endpoint that spends money. Per-IP stops one noisy
# client; the global window is the actual budget ceiling, since a handful of IPs
# defeats any per-IP number. 0 disables either. Both are per-worker.
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600

# true only when exactly one trusted proxy is in front (Render, a load balancer):
# then the rightmost X-Forwarded-For entry is the real client. False locally.
TRUST_PROXY_HEADER=false

# --- Supabase: authentication and the Postgres a Tax Case lives in (ADR 0003) ---
# Full walkthrough in db/README.md. Leave all four empty and the chat tab still
# runs; only the Tax Case routes need them. Never the service_role key: it
# bypasses row level security.

# Project Settings -> Database -> Connection string, the *Session pooler* one:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# It has to be the pooler host. The direct host db.<ref>.supabase.co resolves over
# IPv6 only, and Render's free plan has no IPv6 — so the direct string works on a
# laptop and fails after deploying. Port 5432 is session mode: transaction mode
# (6543) forbids prepared statements, which the LangGraph checkpointer needs.
DATABASE_URL=

# Project Settings -> API. The anon key is public by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Discovery URL from Project Settings -> API -> JWT Keys. Tokens are signed
# asymmetrically (ES256), so there is no shared secret: the backend fetches the
# public key from here. Copying the key itself or its Key ID is not needed.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# LangSmith tracing (core/tracing.py). Empty = off. Values of the sensitive
# fields (benefit_amount_eur, gross_salary, employer_name, address) are redacted
# before upload; the trace keeps the structure and the decisions.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tax-assistant

# The money guards on the public deployment (db/usage.py): cases per account,
# interview steps per user per day, and the project's monthly ceiling — reaching
# it turns the workspace read-only until next month. 0 disables a limit.
CASES_PER_USER=2
INTERVIEW_CALLS_PER_USER_PER_DAY=150
INTERVIEW_CALLS_GLOBAL_PER_MONTH=3000

# UUID of a user created by hand in Authentication -> Users, for the tests that talk
# to the real database (`pytest -m integration`). Creating a user from a test would
# need the service_role key, which is not held anywhere. Leave empty and those tests
# skip themselves; everything else runs regardless.
TEST_USER_ID=
